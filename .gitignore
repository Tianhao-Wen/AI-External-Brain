# ── 本地凭据：绝不提交 ──
.env
.env.*
!.env.example

# 真实运行配置（含 API key）。提交模板 .aieb/config.yaml.example 即可。
.aieb/config.yaml
.aieb/config.local.yaml

# 用户运行数据（会话 / 记忆 / 历史 / 计划 / 文件版本），属于隐私数据
.aieb/session/
.aieb/sessions/
.aieb/memory/
.aieb/history
.aieb/plans/
.aieb/file-history/
.aieb/permissions.local.yaml
.aieb/*.log

# 运行时目录整体忽略，但保留配置模板（AI 外脑 Demo 的独立运行目录）
.aieb/*
!.aieb/config.yaml.example
!.aieb/skills/

# legacy 运行时目录：由 aieb.migration 自动迁移，迁移前也不能提交
.mewcode/

# 私钥/证书
*.pem
*.key
*.p12
*.pfx

# Python / 编辑器
config.yaml
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/
env/
*.egg-info/
dist/
build/
.idea/
.vscode/
.claude/
CLAUDE.md

# 测试 / 类型检查 / 覆盖率产物
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# 数据库与向量库数据（运行时生成，绝不提交）
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite
*.db
*.db-wal
*.db-shm
/qdrant_storage/
/storage/
/snapshots/

# 模型与 Embedding 缓存（可重建，体积大）
/models/
/.cache/
*.onnx
fastembed_cache/
/huggingface/

# 日志与系统垃圾文件
*.log
.DS_Store
Thumbs.db
desktop.ini
*.pid
*.tmp

# 前端依赖（Web UI 使用 CDN，无构建步骤）
node_modules/
package-lock.json

# Benchmark 临时工作区（每次运行生成的独立 SQLite/会话/上传文件，属于可再生产物）
benchmarks/.work/
benchmarks/**/__pycache__/

# Playwright snapshot leaks
example-com-snapshot.md
example-*.md

# 个人 / 临时数据（非产品代码，分类见 docs/REPO_INVENTORY.md）
all_jobs.jsoncandidates.json
details.json
jobs_summary.txt
meituan_ai_jobs.json
mt_api*.json
api_hits.txt
api_try.txt
bing_rss*.xml
bing.html
