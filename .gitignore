# 本地调试/测试输出
.*.out
.*.err
.aieb_srv.*
.collect.out

# 应用生成的导出产物（PPT 等）属于运行数据，不提交
汇报材料/


# Benchmark 中间产物（可再生成）
docs/_risk_cases.json
# Qdrant 本地二进制与数据（Windows 无 Docker 时的运行路径）
tools/qdrant/

# 混合检索运行期缓存（Embedding 向量缓存、模型缓存，可重建）
.aieb/cache/
benchmarks/.work/
.venv-langgraph/
