# AI 外脑 Demo 环境变量示例（复制为 .env 或直接在终端里设置；不要提交真实密钥）

# ── 模型 ───────────────────────────────────────────────
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── 联网搜索（可选；不配置时使用 DuckDuckGo） ─────────
TAVILY_API_KEY=

# ── 邮件发送（可选；不配置时"发送邮件"会明确提示缺少配置）──
# security: ssl（465）/ starttls（587）/ none
# ⚠️ 本地开发保持 AIEB_EMAIL_DRY_RUN=1，真实发送会返回 send_blocked（不假装成功）
AIEB_EMAIL_DRY_RUN=1
AIEB_SMTP_HOST=smtp.example.com
AIEB_SMTP_PORT=465
AIEB_SMTP_SECURITY=ssl
AIEB_SMTP_USER=noreply@example.com
# 使用邮箱服务商生成的「应用专用码」，不要填登录密码；这个文件会进版本库，必须是空值
AIEB_SMTP_PASSWORD=
AIEB_SMTP_FROM=noreply@example.com

# ── 远端访问 token（绑定非本机地址时必填） ────────────
AIEB_REMOTE_TOKEN=

# ── 混合检索（Hybrid RAG；不设置时默认 bm25，行为与改造前完全一致）──────────
# bm25 | vector | hybrid | hybrid_rerank
AIEB_RETRIEVAL_MODE=bm25
# 前端上下文预算：legacy（6000 字符早停）| budgeted（按 token 分配）
AIEB_CONTEXT_BUDGET=legacy
AIEB_CONTEXT_MAX_TOKENS=1800
AIEB_CONTEXT_MAX_CHARS=6000
# 中文约 1.74 字符/token（实测），仅用于预算估算
AIEB_CHARS_PER_TOKEN=1.74

# ── Qdrant 向量库（本地模式：docker compose up -d qdrant）───────────────────────────
# ⚠️  Docker 全栈模式下**不要**在这里写 127.0.0.1：容器内的 127.0.0.1 指向自己。
#     docker compose 会在未设置时自动注入 http://qdrant:6333；本地非容器模式默认 127.0.0.1:6333。
# AIEB_QDRANT_URL=http://127.0.0.1:6333
AIEB_QDRANT_API_KEY=
AIEB_QDRANT_COLLECTION=aieb_chunks
AIEB_QDRANT_TIMEOUT=10

# ── Embedding / Reranker（fastembed + ONNX，不需要 torch）─────────────────
AIEB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AIEB_EMBEDDING_BATCH=32
AIEB_EMBEDDING_CACHE=1
AIEB_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
AIEB_RERANK_TIMEOUT=30
AIEB_RERANK_CANDIDATES=30

# ── 融合参数 ─────────────────────────────────────────────────────────────
AIEB_RRF_K=60
AIEB_RETRIEVAL_CANDIDATES=30

# ── 作用域（预留多租户隔离；当前单库默认 default）────────────────────────
AIEB_RETRIEVAL_SCOPE=default
AIEB_KNOWLEDGE_BASE_ID=default

# ── Docker 部署（docker compose up --build -d）──────────────────────────────
# 容器内监听 0.0.0.0，因此必须提供访问 token（项目安全模型：非 loopback 绑定要鉴权）。
# 生成方式： python -c "import secrets;print(secrets.token_urlsafe(24))"
# 浏览器访问： http://localhost:18888/#token=<与这里一致>
AIEB_REMOTE_TOKEN=
# 宿主与容器使用同一个端口（Origin 校验依赖端口一致；改端口需同时改 allowed_origins）
AIEB_PORT=18888
# Qdrant 宿主端口（仅本机调试用；容器间走 qdrant:6333）
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_LOG_LEVEL=WARN
# 完全受控的内网演示才设为 1（无 token 暴露，不推荐）
AIEB_ALLOW_UNAUTHENTICATED_REMOTE=0
AIEB_LOG_LEVEL=INFO
